{
  "name": "expenses-traker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server ci && npm --prefix client ci",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
